{
  "$schema": "./node_modules/@intisy/bayonet/schema/plugin.schema.json",
  "id": "sync-bridge",
  "api": 1,
  "entry": "dist/index.js",
  "displayName": "Sync Bridge",
  "capabilities": [
    "cross-app-sync",
    "settings"
  ],
  "commands": [
    {
      "name": "sync",
      "description": "Reconcile synced files + mirror sync-enabled plugins across both apps now",
      "shell": "node \"{{BUNDLE}}\" sync",
      "body": "Above is the sync-bridge result (files reconciled + plugins mirrored). Summarize what changed."
    }
  ],
  "config": {
    "defaults": {
      "logging": true,
      "files": [
        {
          "name": "accounts.json",
          "strategy": "accounts"
        }
      ],
      "enabled": true,
      "sync_plugins": true,
      "categories": {
        "accounts": true,
        "plugins": true,
        "settings": true,
        "pluginConfigs": true
      },
      "exclude": [],
      "default_strategy": "newest",
      "debounce_seconds": 0
    }
  },
  "publish": {
    "generatedReadme": true
  },
  "repo": {
    "role": "Cross-app config and account sync plugin",
    "category": "plugin",
    "domains": [
      "claude",
      "opencode"
    ],
    "tech": [
      "typescript"
    ]
  }
}
