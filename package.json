{
  "name": "sync-bridge",
  "version": "0.7.2",
  "description": "Syncs config and account files between Claude Code and OpenCode homes \u00e2\u20ac\u201d the one plugin allowed to span both app directories",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "license": "MIT",
  "author": "intisy",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/intisy-ai/sync-bridge.git"
  },
  "keywords": [
    "opencode",
    "claude",
    "sync",
    "config",
    "core-auth"
  ],
  "files": [
    "dist/",
    "plugin.json",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc --noEmit && node build.mjs",
    "postbuild": "node dist/index.js readme",
    "test": "npm run build && vitest run",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "esbuild": "^0.25.12",
    "typescript": "^5.0.0",
    "vitest": "^3.2.6"
  },
  "dependencies": {
    "@intisy-ai/core": "^1.1.0",
    "@intisy-ai/api": "^1.0.2"
  }
}
